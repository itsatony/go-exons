---
name: base-report
description: The house report layout. Declares the inputs every report shares.
subtype: template
version: 1.0.0
inputs:
  tone:
    type: select
    description: How the report addresses its reader.
    default: formal
    options:
      - value: formal
        label: Formal
      - value: casual
        label: Casual
  audience:
    type: text
    description: Who the report is written for.
    default: engineers
---
